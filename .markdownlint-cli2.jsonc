{
  "config": {
    "MD004": { "style": "dash" },
    "MD010": { "code_blocks": false },
    "MD013": {
      "line_length": 80,
      "code_block_line_length": 120,
      "tables": false,
      "headings": false
    },
    "MD029": { "style": "ordered" }
  },
  "ignores": [
    // Generated artefacts, such as the prediction benchmark's results.md, are
    // written under build/ and are not authored Markdown.
    "**/build/**",
    "**/.venv/**",
    ".node_modules/**",
    "**/node_modules/**",
    "**/target/**",
    ".terraform/**",
    "**/.uv-cache/**",
    "**/.uv-tools/**",
    "**/.tools/**",
    "CRUSH.md"
  ]
}
