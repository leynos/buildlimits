#!/usr/bin/env bash
# The stub launcher the command line's end-to-end test runs.
#
# It answers from the recordings EP-M1 made, choosing between them by what the
# specification retains: a run materialized for a configuration that expects a
# failure drops every other assertion (D3), so a specification that no longer
# declares ``S1`` is the known-bad run and is answered with the recorded lasso.
# Every other run is answered with the recorded pass.
#
# ``MODELCHECK_E2E_ANSWER=pass`` makes it answer a pass to every run, which is
# how the test reproduces the failure this tooling exists to catch: the defect
# is gone and the configuration that expected it must report that it is.
#
# ``MODELCHECK_E2E_ANSWER=unreadable`` and ``=malformed`` reproduce the two ways
# the evidence a counterexample needs can be unusable: a graph that exists but
# cannot be read, and one that is readable but is not an error graph. The
# unreadable mode also prints a runner path, a credential taken from the
# environment and a long transcript, and the malformed mode writes the same
# credential into the graph it saves, JSON-escaped as a real writer would. The
# end-to-end tests read the persisted record back to prove it bounds the capture
# and replaces both the runner path and the credential rather than carrying any
# of them whole.
#
# ``MODELCHECK_E2E_CREDENTIAL`` makes the recorded lasso carry the value of
# ``MODELCHECK_E2E_SECRET`` in every state, spelled as the real checker's Go
# encoder spells it. That spelling is deliberately one no Python JSON writer
# produces, so the value survives a redaction of the graph's text and can only
# be removed from the decoded trace. The saved trace file and the record are
# what the end-to-end test reads back.
#
# ``MODELCHECK_E2E_LOG`` names the file each invocation appends its working
# directory and arguments to. The test points it at its own scratch directory,
# so running the command line never writes into the tracked fixture tree. The
# log is what proves the run happened in a scratch directory rather than beside
# the model.
#
# The variable is required, with no default. A default of "beside this script"
# was the obvious convenience and the wrong one: the plan documents running
# this command by hand, and doing that wrote ``seen.log`` into the tracked
# fixture directory. The damage was then invisible, because ``*.log`` is
# git-ignored and so the ``git status --porcelain`` check the plan uses as its
# cleanliness proof did not see it. Failing loudly makes the hand-run work and
# names what it needs, and a stub that cannot be pointed at a scratch file is
# better than one that quietly dirties the tree.
#
# The ``--output-dir`` argument is honoured, so a graph lands where the adapter
# said it would and an adapter that stopped naming the directory would be
# caught by a missing graph rather than by a passing test.

set -euo pipefail

directory="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if [ -z "${MODELCHECK_E2E_LOG:-}" ]; then
  printf '%s\n' \
    'fizz stub: MODELCHECK_E2E_LOG must name a file outside the fixture tree' >&2
  exit 64
fi
log="$MODELCHECK_E2E_LOG"
printf '%s\n' "$PWD" >> "$log"
printf 'args: %s\n' "$*" >> "$log"

output=""
spec=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --output-dir)
      output="$2"
      shift 2
      ;;
    *)
      spec="$1"
      shift
      ;;
  esac
done

credentialed_graph() {
  # The recorded lasso with the inherited credential in each state, spelled the
  # way the real checker's Go encoder spells it: a quote or a backslash is
  # escaped, and so is a less-than sign, as the six characters backslash-u-0-0-
  # 3-c. Python's JSON writer never escapes that character, so the text pass
  # cannot anticipate this spelling; it is caught only after the graph is
  # decoded into the trace that the saved file and the record carry.
  local escaped="${MODELCHECK_E2E_SECRET:-}" line
  escaped=${escaped//\\/\\\\}
  escaped=${escaped//\"/\\\"}
  escaped=${escaped//</\\u003c}
  # The fixture's last line has no trailing newline, and ``read`` fails on it
  # while still placing it in ``line``; testing the variable keeps that line.
  while IFS= read -r line || [ -n "$line" ]; do
    if [ "$line" = '        "b": 0,' ]; then
      printf '        "b": "%s",\n' "$escaped"
    else
      printf '%s\n' "$line"
    fi
  done < "$directory/lasso-error-graph.json"
}

emit_lasso() {
  if [ -n "$output" ]; then
    mkdir -p "$output"
    if [ -n "${MODELCHECK_E2E_CREDENTIAL:-}" ]; then
      credentialed_graph > "$output/error-graph.json"
    else
      cp "$directory/lasso-error-graph.json" "$output/error-graph.json"
    fi
  fi
  cat "$directory/lasso-stdout.txt"
}

case "${MODELCHECK_E2E_ANSWER:-recorded}" in
  pass)
    cat "$directory/pass-stdout.txt"
    exit 0
    ;;
  unreadable)
    # A directory where the graph should be is the cheapest unreadable graph.
    mkdir -p "$output/error-graph.json"
    printf 'token=%s\n' "${MODELCHECK_E2E_SECRET:-}"
    printf 'cache %s/.cache/go-build\n' "${HOME:-}"
    printf 'reading %s/model.fizz\n' "$PWD"
    printf 'x%.0s' {1..5000}
    printf '\n'
    cat "$directory/lasso-stdout.txt"
    exit 0
    ;;
  malformed)
    mkdir -p "$output"
    # A JSON writer escapes a quote or a backslash in the value it writes, so
    # the graph holds the escaped form rather than the value itself. The
    # redaction has to cover that form too, or a credential containing either
    # character would reach the record in the one shape the checker used.
    escaped=${MODELCHECK_E2E_SECRET:-}
    escaped=${escaped//\\/\\\\}
    escaped=${escaped//\"/\\\"}
    printf '{"not": "a list", "token": "%s"}' "$escaped" \
      > "$output/error-graph.json"
    cat "$directory/lasso-stdout.txt"
    exit 0
    ;;
esac

# A fixpoint comparison materializes the same configuration twice: once at the
# declared bound and once at twice that bound. Answering the doubled bound with
# the lasso gives ``--fixpoint`` a failing comparison, so the end-to-end test
# can prove the failure and its evidence survive the non-zero exit.
if grep -q 'assertion S1' "$spec" && grep -q 'max_actions: 16' "$spec"; then
  emit_lasso
  exit 0
fi

if grep -q 'assertion S1' "$spec"; then
  cat "$directory/pass-stdout.txt"
else
  emit_lasso
fi
